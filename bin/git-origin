#!/usr/bin/env bash

set -eu -o pipefail

usage() {
    cat <<USAGE
Usage: git-origin <command>

Commands:
  ssh                     Rewrite origin to git@host:owner/repo.git
  https                   Rewrite origin to https://host/owner/repo.git
                          Both then run default-branch and set gh's
                          git_protocol to match (github.com only).
  default-branch [name]   Point local and origin/HEAD at the remote's default
                          branch (e.g. main or master). Auto-detected if
                          omitted. Renames local master<->main if needed.
USAGE
}

# Sets host and path (owner/repo) from an https, ssh:// or scp-style URL.
parse_url() {
    local url="$1"
    if [[ $url =~ ^(https?|ssh)://([^@/]+@)?([^/:]+)(:[0-9]+)?/(.+)$ ]]; then
        host="${BASH_REMATCH[3]}" path="${BASH_REMATCH[5]}"
    elif [[ $url =~ ^([^@]+@)?([^:/]+):(.+)$ ]]; then
        host="${BASH_REMATCH[2]}" path="${BASH_REMATCH[3]}"
    else
        echo "Cannot parse origin URL: $url" >&2
        return 1
    fi
    path="${path%/}"
    path="${path%.git}"
    if [[ $path != */* ]]; then
        echo "Origin URL has no owner/repo: $url" >&2
        return 1
    fi
}

# set-url rather than remove/add: removing the remote drops every branch's
# upstream config.
set_origin() {
    local scheme="$1" current url
    if ! current=$(git config --get remote.origin.url); then
        echo "No origin remote configured" >&2
        return 1
    fi
    parse_url "$current"
    case "$scheme" in
    ssh) url="git@${host}:${path}.git" ;;
    https) url="https://${host}/${path}.git" ;;
    esac
    git remote set-url origin "$url"
    echo "origin -> $url"
}

# Best effort: origin is already switched, so a gh failure only warns.
set_gh_protocol() {
    local scheme="$1"
    [[ $host == github.com ]] && is there gh || return 0
    if gh config set -h github.com git_protocol "$scheme"; then
        echo "gh git_protocol -> $scheme"
    else
        echo "warning: could not set gh git_protocol to $scheme" >&2
    fi
}

default_branch() {
    local name="${1:-}" other
    git fetch --prune origin
    if [[ -z $name ]]; then
        git remote set-head origin --auto >/dev/null
        name=$(git symbolic-ref --short refs/remotes/origin/HEAD)
        name="${name#origin/}"
    fi
    if ! git show-ref --verify --quiet "refs/remotes/origin/$name"; then
        echo "origin/$name does not exist" >&2
        return 1
    fi
    case "$name" in
    main) other=master ;;
    master) other=main ;;
    *) other= ;;
    esac
    if ! git show-ref --verify --quiet "refs/heads/$name" &&
        [[ -n $other ]] && git show-ref --verify --quiet "refs/heads/$other"; then
        git branch -m "$other" "$name"
    fi
    if git show-ref --verify --quiet "refs/heads/$name"; then
        git branch -u "origin/$name" "$name"
    fi
    git remote set-head origin "$name"
    echo "default branch -> $name"
}

case "${1:-}" in
ssh | https)
    [[ $# -eq 1 ]] || {
        usage >&2
        exit 1
    }
    host='' path=''
    set_origin "$1"
    default_branch
    set_gh_protocol "$1"
    ;;
default-branch)
    [[ $# -le 2 ]] || {
        usage >&2
        exit 1
    }
    default_branch "${2:-}"
    ;;
-h | --help)
    usage
    exit 0
    ;;
*)
    usage >&2
    exit 1
    ;;
esac
