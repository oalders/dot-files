#!/bin/bash

set -eu -o pipefail

# Preflight for nn/nono on kernels older than Linux 6.12.
#
# nono's supervised credential-proxy mode (entered by every network-enabled
# profile) hard-requires Landlock ABI V6, first shipped in Linux 6.12. On an
# older kernel (e.g. Ubuntu 24.04's GA 6.8, which reports Landlock V4) the
# sandbox aborts at init with a misleading error that blames the network fd
# handoff, not the kernel:
#
#   recv_raw_fd_number failed: failed to fill whole buffer
#
# This check surfaces the real cause first. It asks nono two questions rather
# than parsing `uname`, so backported, degrading, or post-upgrade kernels all
# work with no change here:
#   1. Is Landlock signal scoping supported? (kernel ABI >= V6)
#   2. Does the resolved profile run the filtering proxy (supervised mode)?
# Only when scoping is unsupported AND the profile is proxy-supervised do we
# block — direct-network and net-blocked profiles survive on V4 and must not be.
#
# Invariant: fail OPEN on any uncertainty (no profile, nono missing, empty or
# unexpected query result) so the check never breaks a launch it can't
# positively diagnose. See https://github.com/oalders/dot-files/issues/1024.
#
# Usage: nono-preflight <profile>   (exit 0 = safe/uncertain; exit 1 = blocked,
# with the real cause and fix printed to stderr).

profile="${1:-}"

# No profile / no nono: nothing to probe, and a missing nono fails the launch
# for an obvious reason anyway. Fail open.
[[ -n $profile ]] || exit 0
command -v nono >/dev/null 2>&1 || exit 0

# (1) Landlock signal scoping. Only a literal "false" is a positive "kernel
# lacks V6"; anything else means we can't tell, so fall through and fail open.
# `|| true` keeps a nono error from tripping set -e into the false branch.
signal_supported=$(
    nono why --scope signal 2>/dev/null |
        awk -F': *' '/^[[:space:]]*Supported:/ { print $2; exit }' || true
)
[[ $signal_supported == false ]] || exit 0

# (2) Supervised proxy mode. Probe a host in the RFC 2606-reserved .invalid TLD
# so it can never be in a profile's allow_domain: a proxy-supervised profile
# reports `proxy_filtered` (the mode that needs V6), while unrestricted-outbound
# and net-blocked profiles report something else and correctly fall through.
probe=$(nono why --host nono-preflight-probe.invalid --profile "$profile" 2>/dev/null || true)
grep -q 'proxy_filtered' <<<"$probe" || exit 0

# Both conditions hold: this launch would crash at sandbox init. Explain the
# real cause and the fix instead of letting the opaque error surface.
nono_version=$(nono --version 2>/dev/null | awk '{ print $2 }' || true)
kernel=$(uname -r)

cat >&2 <<EOF
🗯️nn: refusing to launch — this kernel is too old for nono ${nono_version:-v0.74.0+}.

  Profile '$profile' uses nono's supervised credential proxy, which requires
  Landlock ABI V6 (LANDLOCK_SCOPE_SIGNAL, kernel >= 6.12). This kernel
  ($kernel) reports Landlock V4, so the sandbox would abort at init with a
  misleading "recv_raw_fd_number failed" error.

  Fix (recommended): upgrade to a kernel >= 6.12, then reboot:
      ~/dot-files/bin/upgrade-to-hwe-kernel.sh
      sudo reboot

  Temporary workaround: pin nono to the last pre-V6 release in
  installer/ubi.sh, then re-run the installer:
      maybe_install nolabs-ai/nono --tag v0.73.0

  See: https://github.com/oalders/dot-files/issues/1024
EOF
exit 1
