#!/usr/bin/env perl

# gh wrapper: refuse mutating `gh` writes whose body lacks a correct
# attribution trailer.
#
# Why a wrapper and not (only) the kitchen-sink PreToolUse hook: that hook
# inspects the raw *shell command string*, so it fails open on the common case
# where the body is built with a heredoc or the command is compound/redirected
# (exactly how an LLM tends to write `gh` calls). This wrapper runs as `gh` and
# sees the *final argv* — after the shell has expanded every heredoc, variable,
# and substitution — so that whole fragility class disappears.
#
# The wrapper validates; it never writes the trailer. The caller knows which
# model it is, so it writes the trailer and this only checks the shape:
#
#   🤖 Generated with [Claude Code](https://claude.com/claude-code) · Opus 5.5
#   🤖 Review by [Claude Code](https://claude.com/claude-code) · Opus 5.5
#
# "Review by" is required on review/reply endpoints, "Generated with" elsewhere.
# Bodies containing a Claude Code session link or id are refused too.
#
# Scope: only mutating writes (`issue`/`pr` create|comment|edit, and `gh api`
# POST/PATCH to comment/issue/pull/review/reply endpoints) that carry a body.
# Everything else — and every invocation outside a Claude session ($CLAUDECODE
# unset), i.e. the human's own `gh` use — passes through untouched.

use strict;
use warnings;

use Cwd        qw( realpath );
use File::Temp qw( tempfile );
use JSON::PP   ();

# Bodies are treated as byte strings; these hold raw UTF-8 (robot face, middot).
my $ANCHOR = '[Claude Code](https://claude.com/claude-code)';
my $ROBOT  = "\xF0\x9F\xA4\x96";
my $DOT    = "\xC2\xB7";
my $MODEL  = qr/(?:Opus|Sonnet|Haiku|Fable) \d+(?:\.\d+)?/;

# Endpoints whose `gh api` POST/PATCH bodies are user-visible GitHub content.
my @API_ENDPOINT_NEEDLES = qw( /comments /issues /pulls /reviews /replies );

my @temp_files;
END { unlink @temp_files if @temp_files }    # also on refuse-to-post exits

# Resolve the real gh: first executable named `gh` on PATH that is not this
# wrapper. Fall back to the usual system path so we never recurse into ourself.
sub real_gh {
    my $self = realpath($0) // $0;
    for my $dir ( split /:/, ( $ENV{PATH} // q{} ) ) {
        next if $dir eq q{};
        my $cand = "$dir/gh";
        next if !-x $cand || -d $cand;
        next if ( realpath($cand) // $cand ) eq $self;
        return $cand;
    }
    return '/usr/bin/gh';
}

# Hand off to the real gh. We system()+exit rather than exec() whenever we
# wrote a temp file, so END can clean it up; a pure pass-through still exec()s.
sub run_real {
    my @cmd = ( real_gh(), @_ );
    if (@temp_files) {
        my $status = system { $cmd[0] } @cmd;
        exit 1               if $status == -1;
        exit 128 + ( $status & 127 ) if $status & 127;
        exit $status >> 8;
    }
    exec { $cmd[0] } @cmd or do {
        print {*STDERR} "gh-wrapper: cannot exec $cmd[0]: $!\n";
        exit 1;
    };
}

sub block {
    my ($why) = @_;
    print {*STDERR} "gh-wrapper: refusing to post — $why.\n";
    exit 1;
}

# Refuse unless $body ends with the trailer for $verb and leaks no session.
sub check {
    my ( $body, $verb ) = @_;
    my $sid = $ENV{CLAUDE_CODE_SESSION_ID};
    block('the body must not contain a Claude Code session link or id')
        if $body =~ m{claude\.ai/code/(?:session|[0-9a-f]{8}-[0-9a-f]{4}-)}i
        || $body =~ /session_01[0-9A-Za-z]{16,}/
        || ( $sid && $body =~ /\Q$sid\E/i );
    return if $body =~ /^\Q$ROBOT $verb $ANCHOR $DOT \E$MODEL[ \t]*\s*\z/m;
    block( "the body must end with the attribution trailer, e.g.\n"
            . "  $ROBOT $verb $ANCHOR $DOT Opus 5.5\n"
            . "using the name and version of the model you are running as" );
}

# Read a body source: a file path, or `-` for stdin. Returns the body and the
# path to pass on to gh — stdin and pipes (`<(...)`, /dev/stdin) are copied to
# a temp file, since reading them here consumes them.
sub read_body {
    my ($path) = @_;
    my $fh;
    if ( $path eq q{-} ) {
        $fh = \*STDIN;
    }
    else {
        block("body file '$path' is unreadable") if -d $path;
        open $fh, '<', $path or block("body file '$path' is unreadable");
    }
    binmode $fh, ':raw';
    my $body = do { local $/; <$fh> } // q{};
    return ( $body, $path ) if $path ne q{-} && -f $path;

    my ( $out, $tmp )
        = tempfile( 'gh-body-XXXXXX', TMPDIR => 1, SUFFIX => '.md' );
    binmode $out, ':raw';
    print {$out} $body;
    close $out;
    push @temp_files, $tmp;
    return ( $body, $tmp );
}

my @argv = @ARGV;

# Outside a Claude session, or with no args, do nothing but hand off.
run_real(@argv) if !$ENV{CLAUDECODE} || !@argv;

# gh accepts global flags before the subcommand (e.g. `gh --repo o/r issue ...`).
# Skip them to find the real subcommand; value-taking globals eat their operand.
my %VALUE_GLOBAL = map { $_ => 1 } qw( -R --repo --hostname );
my $i            = 0;
while ( $i < @argv && $argv[$i] =~ /^-/ ) {
    $i += ( $VALUE_GLOBAL{ $argv[$i] } && $argv[$i] !~ /=/ ) ? 2 : 1;
}
run_real(@argv) if $i >= @argv;

my $sub = $argv[$i];

if ( $sub eq 'issue' || $sub eq 'pr' ) {
    my $action = $argv[ $i + 1 ] // q{};
    run_real(@argv)
        if $action ne 'create' && $action ne 'comment' && $action ne 'edit';

    # Check every body flag. The glued shorthands (-bTEXT, -FFILE) are valid
    # pflag syntax. No body flag at all → editor/--fill; leave it alone.
    for ( my $j = $i + 2 ; $j < @argv ; $j++ ) {
        my $tok = $argv[$j];
        last if $tok eq '--';    # the rest are positional, not flags
        if ( ( $tok eq '--body' || $tok eq '-b' ) && $j + 1 < @argv ) {
            check( $argv[ ++$j ], 'Generated with' );
        }
        elsif ( $tok =~ /^(?:--body=|-b)(.+)/s ) {
            check( $1, 'Generated with' );
        }
        elsif ( ( $tok eq '--body-file' || $tok eq '-F' ) && $j + 1 < @argv ) {
            $j++;
            ( my $body, $argv[$j] ) = read_body( $argv[$j] );
            check( $body, 'Generated with' );
        }
        elsif ( $tok =~ /^(--body-file=|-F)(.+)/s ) {
            my $prefix = $1;
            my ( $body, $path ) = read_body($2);
            check( $body, 'Generated with' );
            $argv[$j] = $prefix . $path;
        }
    }
    run_real(@argv);
}

if ( $sub eq 'api' ) {
    my ( $method, $endpoint );

    # First pass: resolve method + endpoint so we know whether to act. Value-
    # taking flags must eat their operand or it would be taken as the endpoint.
    # gh defaults to POST when any field or --input is passed.
    my %VALUE_FLAG = map { $_ => 1 } qw(
        -H --header -q --jq -t --template --input --cache -p --preview
        --hostname -f --raw-field -F --field
    );
    my ( $has_field, $input_pos, $input_glued ) = (0);
    for ( my $j = $i + 1 ; $j < @argv ; $j++ ) {
        my $tok = $argv[$j];
        if ( ( $tok eq '-X' || $tok eq '--method' ) && $j + 1 < @argv ) {
            $method = $argv[ ++$j ];
        }
        elsif ( $tok =~ /^--method=(.*)/s ) { $method = $1 }
        elsif ( $tok =~ /^-X(.+)/s )        { $method = $1 }
        elsif ( $tok eq '--input' && $j + 1 < @argv ) {
            ( $has_field, $input_pos, $input_glued ) = ( 1, ++$j, q{} );
        }
        elsif ( $tok =~ /^--input=/ ) {
            ( $has_field, $input_pos, $input_glued ) = ( 1, $j, '--input=' );
        }
        elsif ( $VALUE_FLAG{$tok} ) {
            $has_field = 1 if $tok =~ /^(?:-[fF]|--(?:raw-)?field)$/;
            $j++;
        }
        elsif ( $tok =~ /^(?:-[fF].|--(?:raw-)?field=)/ ) { $has_field = 1 }
        elsif ( $tok !~ /^-/ && !defined $endpoint )      { $endpoint  = $tok }
    }
    $method //= 'POST' if $has_field;
    run_real(@argv) if !defined $method || uc($method) !~ /^(?:POST|PATCH)$/;
    run_real(@argv)
        if !defined $endpoint
        || !grep { index( $endpoint, $_ ) >= 0 } @API_ENDPOINT_NEEDLES;
    my $verb
        = $endpoint =~ m{/(?:reviews|replies)\b} ? 'Review by' : 'Generated with';

    # --input JSON: only a top-level "body" is checked; anything else (e.g. a
    # review with only inline comments[]) passes through as-is.
    if ( defined $input_pos ) {
        my ( $raw, $path )
            = read_body( substr $argv[$input_pos], length $input_glued );
        $argv[$input_pos] = $input_glued . $path;
        my $data = eval { JSON::PP->new->utf8->decode($raw) };
        if ( ref $data eq 'HASH' && defined $data->{body} && !ref $data->{body} ) {
            utf8::encode( my $body = $data->{body} );
            check( $body, $verb );
        }
    }

    # Second pass: check every `body=` field. `-F/--field` treats a leading `@`
    # as a file; `-f/--raw-field` is always a literal. $glued is the prefix to
    # preserve when the value lives inside the flag token itself.
    for ( my $j = $i + 1 ; $j < @argv ; $j++ ) {
        my $tok = $argv[$j];
        my ( $is_field, $pos, $glued );
        if ( ( $tok eq '-F' || $tok eq '--field' ) && $j + 1 < @argv ) {
            ( $is_field, $pos ) = ( 1, ++$j );
        }
        elsif ( ( $tok eq '-f' || $tok eq '--raw-field' ) && $j + 1 < @argv )
        {
            ( $is_field, $pos ) = ( 0, ++$j );
        }
        elsif ( $tok =~ /^(--field|--raw-field)=/ ) {
            ( $is_field, $pos, $glued ) = ( $1 eq '--field', $j, "$1=" );
        }
        elsif ( $tok =~ /^-([fF])./ ) {
            ( $is_field, $pos, $glued ) = ( $1 eq 'F', $j, "-$1" );
        }
        else { next }

        $glued //= q{};
        my $val = substr $argv[$pos], length $glued;
        next if $val !~ /^body=(.*)/s;
        my $body_val = $1;

        if ( $is_field && $body_val =~ /^\@(.*)/s ) {    # -F body=@file
            my ( $body, $path ) = read_body($1);
            check( $body, $verb );
            $argv[$pos] = $glued . 'body=@' . $path;
        }
        else {                                           # literal body= value
            check( $body_val, $verb );
        }
    }

    run_real(@argv);
}

# Non-write subcommand: hand off unchanged.
run_real(@argv);
