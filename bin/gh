#!/usr/bin/env perl

# gh wrapper: refuse mutating `gh` writes whose body lacks a correct
# attribution trailer.
#
# Why a wrapper and not (only) the kitchen-sink PreToolUse hook: that hook
# inspects the raw *shell command string*, so it fails open on the common case
# where the body is built with a heredoc or the command is compound/redirected
# (exactly how an LLM tends to write `gh` calls). This wrapper runs as `gh` and
# sees the *final argv* — after the shell has expanded every heredoc, variable,
# and substitution — so that whole fragility class disappears.
#
# The wrapper validates; it never writes the trailer. The caller knows which
# model it is, so it writes the trailer and this only checks the shape:
#
#   🤖 Generated with [Claude Code](https://claude.com/claude-code) · Opus 5.5
#   🤖 Review by [Claude Code](https://claude.com/claude-code) · Opus 5.5
#
# "Review by" is required for reviews and review replies, "Generated with"
# elsewhere. Merge commit bodies, release notes and titles need no trailer,
# but like every body they are refused if they hold a Claude Code session
# link or id.
#
# Scope: `issue`/`pr` create|new|edit|comment|close, `pr review`, `pr merge`,
# `release` create|edit, and `gh api` POST/PATCH/PUT to comment/issue/pull/
# review/reply endpoints or GraphQL mutations. Everything else — and every
# invocation outside a Claude session ($CLAUDECODE unset), i.e. the human's
# own `gh` use — passes through untouched.

use strict;
use warnings;

use Cwd        qw( realpath );
use File::Temp qw( tempfile );
use JSON::PP   ();

# Bodies are treated as byte strings; these hold raw UTF-8 (robot face, middot).
my $ANCHOR = '[Claude Code](https://claude.com/claude-code)';
my $ROBOT  = "\xF0\x9F\xA4\x96";
my $DOT    = "\xC2\xB7";
my $MODEL  = qr/(?:Opus|Sonnet|Haiku|Fable) \d+(?:\.\d+)?/;

# Endpoints whose `gh api` write bodies are user-visible GitHub content.
my @API_ENDPOINT_NEEDLES = qw( /comments /issues /pulls /reviews /replies );

my @temp_files;
END { unlink @temp_files if @temp_files }    # also on refuse-to-post exits

# Resolve the real gh: first executable named `gh` on PATH that is not this
# wrapper. Fall back to the usual system path so we never recurse into ourself.
sub real_gh {
    my $self = realpath($0) // $0;
    for my $dir ( split /:/, ( $ENV{PATH} // q{} ) ) {
        next if $dir eq q{};
        my $cand = "$dir/gh";
        next if !-x $cand || -d $cand;
        next if ( realpath($cand) // $cand ) eq $self;
        return $cand;
    }
    return '/usr/bin/gh';
}

# Hand off to the real gh. Whenever we wrote a temp file we fork and wait
# rather than exec(), so END can clean it up; TERM/HUP are forwarded to gh so
# we outlive it and still clean up. A pure pass-through exec()s.
sub run_real {
    my @cmd = ( real_gh(), @_ );
    if (@temp_files) {
        my $pid = fork;
        if ( !defined $pid ) {
            print {*STDERR} "gh-wrapper: cannot fork: $!\n";
            exit 1;
        }
        if ( !$pid ) {
            exec { $cmd[0] } @cmd or do {
                print {*STDERR} "gh-wrapper: cannot exec $cmd[0]: $!\n";
                exit 127;
            };
        }
        local $SIG{TERM} = local $SIG{HUP}  = sub { kill $_[0] => $pid };
        local $SIG{INT}  = local $SIG{QUIT} = 'IGNORE';    # as system() does
        waitpid $pid, 0;
        exit 128 + ( $? & 127 ) if $? & 127;
        exit $? >> 8;
    }
    exec { $cmd[0] } @cmd or do {
        print {*STDERR} "gh-wrapper: cannot exec $cmd[0]: $!\n";
        exit 1;
    };
}

sub block {
    my ($why) = @_;
    print {*STDERR} "gh-wrapper: refusing to post — $why.\n";
    exit 1;
}

# Refuse if $text leaks a Claude Code session link or id.
sub check_leak {
    my ($text) = @_;
    my $sid = $ENV{CLAUDE_CODE_SESSION_ID};
    block('the text must not contain a Claude Code session link or id')
        if $text =~ m{claude\.ai/code/(?:session|[0-9a-f]{8}-[0-9a-f]{4}-)}i
        || $text =~ /session_01[0-9A-Za-z]{16,}/
        || ( $sid && $text =~ /\Q$sid\E/i );
}

# Refuse unless $body leaks no session and, when $verb is given, ends with the
# trailer for $verb.
sub check {
    my ( $body, $verb ) = @_;
    check_leak($body);
    return if !defined $verb;
    return if $body =~ /^\Q$ROBOT $verb $ANCHOR $DOT \E$MODEL[ \t]*\s*\z/m;
    block(    "the body must end with the attribution trailer, e.g.\n"
            . "  $ROBOT $verb $ANCHOR $DOT Opus 5.5\n"
            . "using the name and version of the model you are running as" );
}

# Read a body source: a file path, or `-` for stdin. Returns the body and the
# path to pass on to gh — stdin and pipes (`<(...)`, /dev/stdin) are copied to
# a temp file, since reading them here consumes them.
sub read_body {
    my ($path) = @_;
    my $fh;
    if ( $path eq q{-} ) {
        $fh = \*STDIN;
    }
    else {
        block("body file '$path' is unreadable") if -d $path;
        open $fh, '<', $path or block("body file '$path' is unreadable");
    }
    binmode $fh, ':raw';
    my $body = do { local $/; <$fh> }
        // q{};
    return ( $body, $path ) if $path ne q{-} && -f $path;

    my ( $out, $tmp )
        = tempfile( 'gh-body-XXXXXX', TMPDIR => 1, SUFFIX => '.md' );
    binmode $out, ':raw';
    print {$out} $body;
    close $out;
    push @temp_files, $tmp;
    return ( $body, $tmp );
}

# Find every value-taking flag in @$argv from $start on, the way pflag parses
# them: `--long v`, `--long=v`, `-sv`, `-s=v`, `-s v`, and stacked booleans
# such as `-ds v`. %$spec maps long name => [ short letter, role ]; flags not
# in it are booleans (or unknown, which makes gh itself fail). Returns a list
# of { name, role, pos, prefix } — the value is substr $argv[pos], length
# prefix — and the positional arguments.
sub parse_flags {
    my ( $argv, $start, $spec ) = @_;
    my %short = map { $spec->{$_}[0] ? ( $spec->{$_}[0] => $_ ) : () }
        keys %$spec;
    my ( @found, @positional );
    for ( my $j = $start ; $j < @$argv ; $j++ ) {
        my $tok = $argv->[$j];
        if ( $tok eq '--' ) {
            push @positional, @{$argv}[ $j + 1 .. $#$argv ];
            last;
        }
        if ( $tok =~ /^--([^=]+)(=?)/ ) {
            my $name = $1;
            next if !$spec->{$name};
            my %f = ( name => $name, role => $spec->{$name}[1] );
            if ($2) { push @found, { %f, pos => $j, prefix => "--$name=" } }
            elsif ( $j + 1 < @$argv ) {
                push @found, { %f, pos => ++$j, prefix => q{} };
            }
        }
        elsif ( $tok =~ /^-./s ) {
            for my $k ( 1 .. length($tok) - 1 ) {
                my $name = $short{ substr $tok, $k, 1 };
                if ( !$name ) {

                    # `-d=T` gives boolean -d a value; the rest isn't flags.
                    last if substr( $tok, $k + 1, 1 ) eq '=';
                    next;
                }
                my %f = ( name => $name, role => $spec->{$name}[1] );
                if ( $k + 1 < length $tok ) {
                    my $prefix = substr $tok, 0, $k + 1;
                    $prefix .= '=' if substr( $tok, $k + 1, 1 ) eq '=';
                    push @found, { %f, pos => $j, prefix => $prefix };
                }
                elsif ( $j + 1 < @$argv ) {
                    push @found, { %f, pos => ++$j, prefix => q{} };
                }
                last;
            }
        }
        else { push @positional, $tok }
    }
    return ( \@found, \@positional );
}

sub value_of {
    my ( $argv, $f ) = @_;
    return substr $argv->[ $f->{pos} ], length $f->{prefix};
}

# Check the `body`/`file`/`leak` flags of an issue/pr/release command. `body`
# and `file` values need the $verb trailer (if any); `leak` values are only
# scanned for session links. Body files are swapped for the path to pass on.
sub check_flags {
    my ( $argv, $start, $spec, $verb ) = @_;
    my ($found) = parse_flags( $argv, $start, $spec );
    for my $f (@$found) {
        my $val = value_of( $argv, $f );
        if    ( $f->{role} eq 'body' ) { check( $val, $verb ) }
        elsif ( $f->{role} eq 'leak' ) { check_leak($val) }
        elsif ( $f->{role} eq 'file' ) {
            my ( $body, $path ) = read_body($val);
            check( $body, $verb );
            $argv->[ $f->{pos} ] = $f->{prefix} . $path;
        }
    }
}

sub values_spec {
    map { $_ => [ undef, 'value' ] } @_;
}

my %REPO = ( repo => [ 'R', 'value' ] );

my %ISSUE_PR_WRITE = (
    %REPO,
    values_spec(
        qw( attach recover blocked-by blocking parent type ),
        map { ( "add-$_", "remove-$_" ) }
            qw( assignee label project reviewer blocked-by blocking sub-issue )
    ),
    body        => [ 'b', 'body' ],
    'body-file' => [ 'F', 'file' ],
    title       => [ 't', 'leak' ],
    assignee    => [ 'a', 'value' ],
    base        => [ 'B', 'value' ],
    head        => [ 'H', 'value' ],
    label       => [ 'l', 'value' ],
    milestone   => [ 'm', 'value' ],
    project     => [ 'p', 'value' ],
    reviewer    => [ 'r', 'value' ],
    template    => [ 'T', 'value' ],
);

# action => [ spec, trailer verb or undef ]
my %ISSUE_PR = (
    (
        map { $_ => [ \%ISSUE_PR_WRITE, 'Generated with' ] }
            qw( create new edit comment )
    ),
    (
        map {
            $_ => [
                {
                    %REPO, values_spec('duplicate-of'),
                    comment => [ 'c', 'body' ],
                    reason  => [ 'r', 'value' ],
                },
                'Generated with'
            ]
        } qw( close reopen )
    ),
);
my %PR_ONLY = (
    review => [
        { %REPO, body => [ 'b', 'body' ], 'body-file' => [ 'F', 'file' ] },
        'Review by'
    ],
    revert => [
        {
            %REPO,
            body        => [ 'b', 'body' ],
            'body-file' => [ 'F', 'file' ],
            title       => [ 't', 'leak' ],
        },
        'Generated with'
    ],
    merge => [
        {
            %REPO, values_spec('match-head-commit'),
            body           => [ 'b', 'body' ],
            'body-file'    => [ 'F', 'file' ],
            subject        => [ 't', 'leak' ],
            'author-email' => [ 'A', 'value' ],
        },
        undef
    ],
);
my %RELEASE_SPEC = (
    %REPO,
    values_spec(qw( discussion-category notes-start-tag target tag )),
    notes        => [ 'n', 'body' ],
    'notes-file' => [ 'F', 'file' ],
    title        => [ 't', 'leak' ],
);

my @argv = @ARGV;

# Outside a Claude session, or with no args, do nothing but hand off.
run_real(@argv) if !$ENV{CLAUDECODE} || !@argv;

# gh accepts global flags before the subcommand (e.g. `gh --repo o/r issue ...`)
# and `-R` between subcommand and action. Skip them to find each word.
my %VALUE_GLOBAL = map { $_ => 1 } qw( -R --repo --hostname );

sub next_word {
    my ($j) = @_;
    while ( $j < @argv && $argv[$j] =~ /^-/ ) {
        $j += $VALUE_GLOBAL{ $argv[$j] } ? 2 : 1;
    }
    return $j;
}

my $i = next_word(0);
run_real(@argv) if $i >= @argv;
my $sub    = $argv[$i];
my $action = $argv[ next_word( $i + 1 ) ] // q{};

my $cmd
    = $sub eq 'issue' ? $ISSUE_PR{$action}
    : $sub eq 'pr'    ? $ISSUE_PR{$action} // $PR_ONLY{$action}
    : $sub eq 'release'
    ? ( $action =~ /^(?:create|new|edit)$/ && [ \%RELEASE_SPEC, undef ] )
    : undef;
if ($cmd) {
    check_flags( \@argv, $i + 1, @$cmd );
    run_real(@argv);
}

run_real(@argv) if $sub ne 'api';

my ( $found, $positional ) = parse_flags(
    \@argv,
    $i + 1,
    {
        values_spec(qw( cache hostname )),
        method      => [ 'X',   'method' ],
        field       => [ 'F',   'field' ],
        'raw-field' => [ 'f',   'field' ],
        input       => [ undef, 'input' ],
        header      => [ 'H',   'value' ],
        jq          => [ 'q',   'value' ],
        template    => [ 't',   'value' ],
        preview     => [ 'p',   'value' ],
    }
);
my ($endpoint) = @$positional;
my ($method)   = map { value_of( \@argv, $_ ) }
    grep { $_->{role} eq 'method' } reverse @$found;
$method //= 'POST' if grep { $_->{role} =~ /^(?:field|input)$/ } @$found;
my $graphql = defined $endpoint && $endpoint =~ m{(?:^|/)graphql(?:[?#]|\z)};
run_real(@argv) if !defined $method || uc($method) !~ /^(?:POST|PATCH|PUT)$/;
run_real(@argv)
    if !$graphql
    && ( !defined $endpoint
    || !grep { index( $endpoint, $_ ) >= 0 } @API_ENDPOINT_NEEDLES );

# Resolve every field to its content; `-F key=@file` reads a file. All of it is
# scanned for session links, and %field keeps the content by key.
my %field;
my $input;
for my $f (@$found) {
    my $val = value_of( \@argv, $f );
    if ( $f->{role} eq 'input' ) {
        my ( $raw, $path ) = read_body($val);
        $argv[ $f->{pos} ] = $f->{prefix} . $path;
        check_leak($raw);
        $input = eval { JSON::PP->new->utf8->decode($raw) };
        if ( ref $input ) {
            my @todo = ($input);
            while ( defined( my $v = shift @todo ) ) {
                if    ( ref $v eq 'HASH' )  { push @todo, values %$v }
                elsif ( ref $v eq 'ARRAY' ) { push @todo, @$v }
                elsif ( !ref $v ) {
                    utf8::encode( my $s = $v );
                    check_leak($s);
                }
            }
        }
        next;
    }
    next if $f->{role} ne 'field' || $val !~ /^([^=]*)=(.*)/s;
    my ( $key, $content ) = ( $1, $2 );
    if ( $f->{name} eq 'field' && $content =~ /^\@(.*)/s ) {
        ( $content, my $path ) = read_body($1);
        $argv[ $f->{pos} ] = $f->{prefix} . "$key=\@$path";
    }
    check_leak($content);
    $field{$key} = $content;
}

# A JSON string value as bytes, or undef.
sub json_str {
    my ($v) = @_;
    return undef if !defined $v || ref $v;
    utf8::encode( my $s = $v );
    return $s;
}

if ( !$graphql ) {
    my $verb
        = $endpoint =~ m{/(?:reviews|replies)\b}
        ? 'Review by'
        : 'Generated with';

    # Only a top-level body needs the trailer; inline review comments[] don't.
    check( $field{body}, $verb ) if defined $field{body};
    my $body = ref $input eq 'HASH' ? json_str( $input->{body} ) : undef;
    check( $body, $verb ) if defined $body;
    run_real(@argv);
}

# GraphQL: a mutation's body must come from a variable (`body: $x`), so it can
# be checked; inline string bodies are refused. Variables come from fields or
# --input's "variables"; `input: $in` with `in[body]=...` is followed too. As
# on REST, bodies inside lists (review threads[]) need no trailer.
my $vars
    = ref $input eq 'HASH' && ref $input->{variables} eq 'HASH'
    ? $input->{variables}
    : {};
my $query = $field{query}
    // ( ref $input eq 'HASH' ? json_str( $input->{query} ) : undef );
run_real(@argv) if !defined $query || $query !~ /\bmutation\b/;

# GraphQL ignores commas and `#` comments; drop them so they can't hide a body.
( my $q = $query ) =~ s/#[^\n]*//g;
$q =~ tr/,/ /;
block('pass GraphQL mutation bodies as a variable (body: $body, -f body=...)')
    if $q =~ /\bbody\s*:\s*"/;
$q =~ s/"(?:[^"\\]|\\.)*"/""/gs;    # strings can't unbalance the [ ] count

my $verb
    = $q =~ /\b\w*(?:PullRequestReview|ReviewThreadReply)\w*\s*\(/
    ? 'Review by'
    : 'Generated with';
while ( $q =~ /\bbody\s*:\s*\$(\w+)/g ) {
    my $var    = $1;
    my $before = substr $q, 0, $-[0];
    next if ( () = $before =~ /\[/g ) > ( () = $before =~ /\]/g );
    my @bodies = grep { defined } $field{$var}, json_str( $vars->{$var} );
    block("supply the GraphQL variable \$$var holding the body") if !@bodies;
    check( $_, $verb ) for @bodies;
}
for my $var ( $q =~ /\binput\s*:\s*\$(\w+)/g ) {
    my $in = $vars->{$var};
    for my $body (
        $field{"${var}[body]"},
        ref $in eq 'HASH' ? json_str( $in->{body} ) : undef
    ) {
        check( $body, $verb ) if defined $body;
    }
}
run_real(@argv);
