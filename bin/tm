#!/bin/bash

# From the command line, to get a tmux session picker:
# tm<cr>
#
# to get a tmux kill-session picker:
# tm kill-session<cr>

if ! tmux has-session 2>/dev/null; then
    echo "tmux is not running. Exiting."
    exit 0
fi

# Not gum filter: session names embed issue titles, and its fuzzy scoring lets
# scattered word-boundary hits outrank a direct match.
session=$(tmux list-sessions -F \#S | fzf --reverse --no-multi --prompt="Pick any session! ")
subcommand=attach

if [ -z "$session" ]; then
    echo "No session selected. Exiting."
    exit 0
fi

if [ $# -gt 0 ]; then
    subcommand="$1"
elif test "${TMUX+x}"; then
    subcommand="switch"
fi

tmux "$subcommand" -t "$session"
