#!/bin/bash

# From the command line, to get a tmux session picker:
# tm<cr>
#
# to get a tmux kill-session picker:
# tm kill-session<cr>

if ! tmux has-session 2>/dev/null; then
    echo "tmux is not running. Exiting."
    exit 0
fi

# --exact: session names embed issue titles, and fuzzy scoring (fzf's and gum's)
# can rank scattered hits in a title above a direct match.
session=$(tmux list-sessions -F \#S | fzf --exact --reverse --no-multi --color="bg+:#292c42,gutter:-1" --prompt="Pick any session! ")
subcommand=attach-session

if [ -z "$session" ]; then
    echo "No session selected. Exiting."
    exit 0
fi

if [ $# -gt 0 ]; then
    subcommand="$1"
elif test "${TMUX+x}"; then
    subcommand="switch-client"
fi

tmux "$subcommand" -t "$session"
