#!/usr/bin/env bash

set -eu -o pipefail

usage() {
    cat <<'EOF'
Usage: merge-pr [-f|--force] [--close] [gh pr merge/close args...]

Merges the current branch's PR via `gh pr merge`, then removes the
worktree, deletes the local branch, and kills the tmux session for the
worktree. Run from inside the worktree's tmux session.

If the PR is already MERGED, the merge is skipped and teardown runs even
when the branch is no longer on origin — no push required.

Options:
  -f, --force   Discard uncommitted changes in the worktree when
                removing it.
                May appear anywhere in the argument list.
  --close       Close the PR via `gh pr close` instead of merging it,
                then run the same teardown (remove worktree, delete the
                local branch, kill the tmux session) and delete the remote
                branch. Skips the unpushed-commits pre-flight since the
                branch is abandoned. Extra args pass through to
                `gh pr close`. Teardown still runs if the PR is already
                MERGED/CLOSED or no PR exists.

Refuses:
  --auto, --auto-merge   gh pr merge would exit 0 while the PR stays
                         OPEN, and our cleanup would tear down the
                         worktree before the merge actually happens.
  dirty worktree         Bails before merging when there are uncommitted
                         changes, unless --force is given.
EOF
}

# Parse our own --force/-f and --close from anywhere in the argument list.
# Refuse --auto / --auto-merge. --close and -f/--force are consumed here and
# must NOT be forwarded to gh; everything else passes through in gh_args.
force=""
close_mode=""
gh_args=()
for arg in "$@"; do
    case "$arg" in
        -f | --force)
            force="--force"
            ;;
        --close)
            close_mode="1"
            ;;
        --auto | --auto-merge)
            echo "merge-pr: refusing $arg — cleanup would run before the merge completes" >&2
            exit 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            gh_args+=("$arg")
            ;;
    esac
done

# Pre-flight: must be inside a git work tree.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "merge-pr: not inside a git work tree" >&2
    exit 1
fi

branch=$(git rev-parse --abbrev-ref HEAD)

if [[ "$branch" == "HEAD" ]]; then
    echo "merge-pr: detached HEAD — check out a branch first" >&2
    exit 1
fi

# Deferred push pre-flight failure (no upstream / unpushed commits). The check
# only matters for an OPEN PR (`gh pr merge`); a MERGED PR is torn down without
# pushing, so record the reason here and resolve it once the PR state is known.
# Defined unconditionally to stay set under `set -u` (close mode skips the block).
preflight_block_reason=""

if [[ -z "$close_mode" ]]; then
    # Cleared only on the genuinely-no-upstream path, where `@{u}` is unresolved
    # and `git rev-list '@{u}..HEAD'` would abort under `set -e`. Defaults to 1
    # so the unpushed-commit check still runs on a normally tracked branch.
    upstream_ok=1

    # Whether the tracking ref was already refreshed this run; the count block
    # below refetches only when this is empty (no double fetch). Defined here to
    # stay set under `set -u`.
    refreshed_ref=""

    # Pre-flight: branch must have an upstream.
    #
    # `@{u}` fails both when the branch is genuinely unpushed AND when it is
    # already on origin but its local tracking config is wrong (e.g.
    # branch.<name>.remote points at a clone URL instead of "origin"). In the
    # latter case "push first" misdiagnoses the problem — the branch is pushed;
    # only the tracking config needs repair. Distinguish the two by asking
    # origin directly.
    if ! git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        # Invariant: query the full ref path — a bare `ls-remote origin foo`
        # tail-matches `refs/heads/x/foo` and would false-flag an unpushed branch.
        if git ls-remote origin "refs/heads/$branch" 2>/dev/null | grep -q .; then
            # Branch IS on origin; only tracking config is wrong (can't happen
            # for a MERGED PR, whose remote branch is gone), so handle it now
            # rather than deferring. Self-heal instead of prompting: the repair
            # is exactly what the user would type back and changes only which
            # ref `@{u}` names, not the code being merged.
            echo "merge-pr: branch '$branch' is on origin, but local tracking config" >&2
            echo "          is wrong, so '@{u}' does not resolve. The branch is" >&2
            echo "          already pushed, so repairing tracking with" >&2
            echo "          'git branch --set-upstream-to=origin/$branch' and continuing." >&2
            # --set-upstream-to needs a local refs/remotes/origin/<branch>,
            # which this clone may never have fetched or may hold stale. Fetch
            # the one ref explicitly first; the leading `+` force-updates a
            # non-fast-forward stale ref, matching the count block below.
            if ! git fetch origin "+refs/heads/$branch:refs/remotes/origin/$branch" >&2; then
                echo "merge-pr: could not fetch 'refs/heads/$branch' from origin — cannot repair tracking." >&2
                exit 1
            fi
            refreshed_ref=1 # ref is current; count block must not re-fetch it
            # Guarded: a failed repair must not fall through with '@{u}' still
            # unresolved, where `git rev-list` would abort under `set -e`.
            if ! git branch --set-upstream-to="origin/$branch" >&2; then
                echo "merge-pr: could not set upstream to 'origin/$branch' — fix tracking config and re-run." >&2
                exit 1
            fi
        else
            # Genuinely unpushed. Defer instead of bailing — a MERGED PR needs
            # no push. `@{u}` is unresolved, so skip the unpushed-commit check.
            preflight_block_reason="branch '$branch' has no upstream — push first"
            upstream_ok=0
        fi
    fi

    # Pre-flight: no unpushed commits. Runs only when `@{u}` resolves (a repair
    # above leaves upstream_ok=1, so it still runs after one).
    if [[ "$upstream_ok" -eq 1 ]]; then
        # `git rev-list '@{u}..HEAD'` trusts refs/remotes/origin/$branch, which
        # goes stale after a push to a literal URL and then reports a phantom
        # unpushed count. Refresh it first (unless the repair path already did).
        # Invariant: under `set -eu -o pipefail` the fetch MUST use the guarded
        # `if !` form and stay non-fatal, so an unreachable remote falls back to
        # the possibly-stale ref instead of aborting. Full rationale:
        # docs/superpowers/specs/2026-08-12-merge-pr-stale-tracking-ref-design.md
        if [[ -z "$refreshed_ref" ]]; then
            if ! git fetch origin "+refs/heads/$branch:refs/remotes/origin/$branch" >&2; then
                echo "merge-pr: warning: could not refresh 'origin/$branch' — unpushed count may be stale" >&2
            fi
        fi
        unpushed=$(git rev-list --count '@{u}..HEAD')
        if [[ "$unpushed" -ne 0 ]]; then
            preflight_block_reason="branch '$branch' has $unpushed unpushed commit(s) — push first"
        fi
    fi
fi

# Pre-flight: refuse a dirty worktree *before* merging. This runs up front
# (before `gh pr merge`) so we never merge a PR and then strand the user
# with uncommitted work we can't safely clean up. --force is the opt-in to
# discard those changes during cleanup, so it suppresses this bail.
# cwd is the worktree here (the script is run from inside it), so a plain
# `git status` suffices. --ignore-submodules=none counts uncommitted work
# *inside* a submodule as dirty even when the repo sets diff.ignoreSubmodules
# or a per-submodule `ignore`, either of which would otherwise hide it.
if [[ -z "$force" && -n "$(git status --porcelain --ignore-submodules=none)" ]]; then
    echo "merge-pr: worktree has uncommitted changes — commit or stash first," >&2
    echo "          or re-run with: merge-pr --force" >&2
    exit 1
fi

# State capture (before any mutation).
worktree_path=$(git rev-parse --show-toplevel)
git_common_dir=$(git rev-parse --git-common-dir)
# In a linked worktree, --git-common-dir returns the main repo's .git;
# its parent is the main repo working directory. Resolve with `pwd -P`
# (physical path) so it matches `--show-toplevel`, which is already
# symlink-resolved — otherwise a cwd reached through a symlink would make
# the two diverge and break the main-working-tree comparison below.
#
# A submodule breaks that "parent of the git dir" assumption: --git-common-dir
# points into the superproject's .git/modules/<name>, whose parent is
# .git/modules — not a working tree at all. `git worktree remove` run from
# there resolves the superproject, which doesn't own the worktree, and aborts
# "is not a working tree" (#1029-style). The submodule's own main working tree
# is recorded as core.worktree in that git dir; use it when set (unset for a
# plain repo).
if submodule_worktree=$(git -C "$git_common_dir" config core.worktree 2>/dev/null) &&
    [[ -n "$submodule_worktree" ]]; then
    main_repo=$(cd "$git_common_dir" && cd "$submodule_worktree" && pwd -P)
else
    main_repo=$(cd "$git_common_dir" && cd .. && pwd -P)
fi

# PR lookup: state + baseRefName in a single call. `no_pr` records the
# close-mode case where there's no PR at all; teardown still runs, but the
# PR-state dispatch below is skipped.
no_pr=""
if ! pr_info=$(gh pr view --json state,baseRefName -q '[.state, .baseRefName] | @tsv' 2>/dev/null); then
    if [[ -n "$close_mode" ]]; then
        # --close abandons the branch. With no PR to close (never opened, or
        # already deleted) there's simply nothing to close, so fall through to
        # the same teardown. baseRefName is unknown; only the main-working-tree
        # path needs it, and it short-circuits there.
        echo "merge-pr: no PR found for branch '$branch' — proceeding to cleanup"
        no_pr=1
        pr_state=""
        pr_base=""
    else
        # A deferred push pre-flight failure means we can't even identify the
        # PR; surface that actionable reason instead of the generic "no PR
        # found".
        if [[ -n "$preflight_block_reason" ]]; then
            echo "merge-pr: $preflight_block_reason" >&2
            exit 1
        fi
        echo "merge-pr: no PR found for branch '$branch'" >&2
        exit 1
    fi
else
    pr_state=$(echo "$pr_info" | cut -f1)
    pr_base=$(echo "$pr_info" | cut -f2)
fi

# Resolve a deferred push pre-flight failure. It matters only when we'll run
# `gh pr merge` (an OPEN PR). A MERGED PR is torn down without pushing — the
# whole point of deferring. CLOSED/other states fall through to the dispatch
# refusal below.
if [[ -n "$preflight_block_reason" && "$pr_state" == "OPEN" ]]; then
    echo "merge-pr: $preflight_block_reason" >&2
    exit 1
fi

# Pre-flight: current branch must not be the PR's base.
if [[ "$branch" == "$pr_base" ]]; then
    echo "merge-pr: refusing to merge from base branch '$pr_base'" >&2
    exit 1
fi

# Tmux session resolution. Done before mutation so a later cd doesn't
# affect the lookup. Empty string means "no session to kill".
session=""
if [[ -n "${TMUX:-}" ]]; then
    session=$(tmux display-message -p '#S')
elif command -v tmux >/dev/null 2>&1 && tmux list-panes -a >/dev/null 2>&1; then
    # Fallback: find a pane whose start-path matches the worktree.
    # We use pane_start_path (not session_path or pane_current_path)
    # because it reflects where tmux launched the pane and doesn't
    # drift if the user cd's.
    session=$(
        tmux list-panes -a -F '#{session_name}	#{pane_start_path}' |
            awk -F '\t' -v wp="$worktree_path" '$2 == wp {print $1; exit}'
    )
fi

# Dispatch on PR state, mode-aware. An OPEN PR is acted on (merge or close);
# a state that already matches our goal (MERGED for merge, CLOSED for close)
# falls through to cleanup; the mismatched terminal state and anything else
# is refused. Skipped entirely when there's no PR (close mode, `no_pr`) —
# there's nothing to act on, only teardown remains.
if [[ -z "$no_pr" ]]; then
    case "$pr_state" in
        OPEN)
            if [[ -n "$close_mode" ]]; then
                # Unlike `gh pr merge`, `gh pr close` has no implicit
                # current-branch detection — its positional PR arg is
                # required — so pass "$branch" explicitly. Any extra
                # positional/flag args still pass through after it.
                gh pr close "$branch" "${gh_args[@]}"
            else
                gh pr merge "${gh_args[@]}"
            fi
            ;;
        MERGED)
            if [[ -n "$close_mode" ]]; then
                # Closing a merged PR is a no-op, but the rest of --close's
                # teardown is still wanted — skip just the remote action and
                # fall through rather than making the user re-run bare merge-pr.
                # Any extra gh_args have no consumer here and are silently
                # ignored, as in merge mode.
                echo "merge-pr: PR already MERGED — closing is a no-op, proceeding to cleanup"
            else
                echo "merge-pr: PR already MERGED — proceeding to cleanup"
            fi
            ;;
        CLOSED)
            # Only meaningful in close mode; in merge mode this falls through
            # to the `*` refusal below (preserving the existing message).
            if [[ -n "$close_mode" ]]; then
                echo "merge-pr: PR already CLOSED — proceeding to cleanup"
            else
                echo "merge-pr: refusing to act on PR in state '$pr_state'" >&2
                exit 1
            fi
            ;;
        *)
            echo "merge-pr: refusing to act on PR in state '$pr_state'" >&2
            exit 1
            ;;
    esac
fi

# Close mode only: delete the remote branch explicitly. GitHub's
# delete_branch_on_merge (see bin/gh-delete-branch-on-merge) fires only on
# merge, not close, so an abandoned PR would otherwise strand its branch on
# origin. Run before the tmux kill to keep the "kill tmux LAST" invariant.
if [[ -n "$close_mode" ]]; then
    # Only if origin has it — close mode tolerates a never-pushed or
    # already-deleted branch, so a missing ref is normal, not a warning. Full
    # ref path avoids the tail-match pitfall; `--exit-code`'s "ref absent"
    # status is consumed by the `if` and never aborts under `set -e`.
    if git ls-remote --exit-code origin "refs/heads/$branch" >/dev/null 2>&1; then
        if ! git push origin --delete "$branch"; then
            echo "merge-pr: warning: could not delete remote branch 'origin/$branch'; continuing with local cleanup." >&2
        fi
    fi
fi

# Main-working-tree case: worktree_path == main_repo when run from the main
# checkout, not a linked worktree. git won't remove the main tree, and the proc
# kill would target this very checkout (even this script), so skip teardown
# entirely — just switch off the merged/closed branch, delete it, and report.
if [[ "$worktree_path" == "$main_repo" ]]; then
    # No PR and run from the main working tree: there's no linked worktree or
    # its tmux session to tear down, and deleting the branch checked out here
    # would need a base to switch to that we don't have (no PR → no
    # baseRefName). Nothing safe to do — report and leave the branch.
    if [[ -n "$no_pr" ]]; then
        echo "merge-pr: no PR and running from the main working tree — nothing to tear down."
        echo "          Delete the local branch '$branch' manually if you want it gone."
        exit 0
    fi

    # git refuses to delete the branch currently checked out here, so switch
    # to the PR's base first. If `gh pr merge -d` already switched away and
    # deleted the branch, both steps are simply skipped (HEAD is no longer on
    # "$branch", and the branch ref is gone).
    #
    # The switch can legitimately fail (base has no local branch and no
    # origin/<base> to DWIM from — shallow clone, base never fetched). Catch it
    # rather than letting `set -e` abort: the PR is already merged/closed, so
    # report and leave the branch for manual removal.
    if [[ "$(git rev-parse --abbrev-ref HEAD)" == "$branch" ]]; then
        if ! git switch "$pr_base"; then
            echo "merge-pr: PR handled, but could not switch off '$branch' to base '$pr_base'." >&2
            echo "          The local branch was left in place — switch away and delete it manually." >&2
            exit 1
        fi
    fi
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        git branch -D "$branch"
    fi
    echo "merge-pr: ran from the main working tree — no worktree to remove; cleanup done."
    exit 0
fi

# Cleanup. Order matters:
#   1. cd out of the worktree before removing it.
#   2. Remove the worktree.
#   3. Delete the local branch (forced because squash/rebase merges
#      aren't recognized as merged by `git branch -d`).
#   4. Kill the tmux session LAST — when invoked from inside that
#      session, this terminates the script. Nothing may follow.
cd "$main_repo"

# Remove docker containers this session started; they're children of the docker
# daemon, not the process tree kill-worktree-procs walks (see docker-teardown).
teardown_docker="$(dirname "${BASH_SOURCE[0]}")/docker-teardown"
if [ -x "$teardown_docker" ]; then
    "$teardown_docker" "$worktree_path" "$branch" || true
fi

# Kill any agent process trees (nono/claude/serena) still running inside
# the worktree before we remove it. Otherwise they live on with cwd
# "(deleted)", accumulate over days, exhaust RAM and spike load average.
killer="$(dirname "${BASH_SOURCE[0]}")/kill-worktree-procs"
if [ -x "$killer" ]; then
    "$killer" "$worktree_path" || true
else
    echo "merge-pr: warning: kill-worktree-procs not found; skipping process cleanup" >&2
fi

# `git worktree remove` refuses a worktree with submodules unless --force, even
# when clean (a dirty tree was already refused up front unless --force). The
# .gitmodules check over-approximates, but forcing a clean removable tree is
# harmless.
remove_force="$force"
if [[ -f "$worktree_path/.gitmodules" ]]; then
    remove_force="--force"
fi

# shellcheck disable=SC2086
# $remove_force is intentionally unquoted: an empty string must expand
# to nothing, matching the pattern used in bin/add-worktree.
if ! git worktree remove $remove_force "$worktree_path"; then
    echo "" >&2
    echo "merge-pr: failed to remove worktree '$worktree_path' (see git error above)." >&2
    echo "          To remove it manually: git worktree remove --force --force '$worktree_path'" >&2
    exit 1
fi

git branch -D "$branch"

if [[ -n "$session" ]]; then
    tmux kill-session -t "$session"
fi
