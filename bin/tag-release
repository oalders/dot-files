#!/usr/bin/env bash

set -eu -o pipefail

# Tags follow the pattern YYYY-MM-DD-NN (today's date + incrementing suffix).
# Auto-detects the next suffix (e.g. 2026-03-22-01, then -02, etc.).
# Override with: tag-release [options] [tag] [max_prs]

usage() {
    cat <<USAGE
Usage: tag-release [options] [tag] [max_prs]

Tags follow YYYY-MM-DD-NN by default (today's date + incrementing suffix).

Options:
  -y, --yes         Skip the confirmation prompt (also: TAG_RELEASE_YES=1)
      --no-summary  Skip Claude summarization, use PR titles only
                    (also: TAG_RELEASE_NO_SUMMARY=1)
      --dry-run     Generate notes but skip git tag, push, and GitHub Release
                    (also: TAG_RELEASE_DRY_RUN=1)
  -h, --help        Show this help and exit

Positional arguments:
  tag         Override the auto-computed tag (default: today's date + suffix)
  max_prs     Max merged PRs to scan since last tag (default: 50)
USAGE
}

# Default flag values; environment variables seed them, command-line flags override.
YES="${TAG_RELEASE_YES:-}"
NO_SUMMARY="${TAG_RELEASE_NO_SUMMARY:-}"
DRY_RUN="${TAG_RELEASE_DRY_RUN:-}"

POSITIONAL=()
while [ $# -gt 0 ]; do
    case "$1" in
    -y | --yes)
        YES=1
        shift
        ;;
    --no-summary)
        NO_SUMMARY=1
        shift
        ;;
    --dry-run)
        DRY_RUN=1
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    --)
        shift
        while [ $# -gt 0 ]; do
            POSITIONAL+=("$1")
            shift
        done
        break
        ;;
    -*)
        echo "Error: unknown option: $1" >&2
        echo "Run 'tag-release --help' for usage." >&2
        exit 2
        ;;
    *)
        POSITIONAL+=("$1")
        shift
        ;;
    esac
done

# Restore positionals. `"${arr[@]}"` is set -u safe for empty arrays in bash 4.4+.
set -- "${POSITIONAL[@]}"

if [ -z "${1:-}" ]; then
    TODAY=$(date +%Y-%m-%d)
    # grep -oE (not -oP): BSD/macOS grep lacks -P. 10# forces base-10 so a
    # zero-padded suffix like 08/09 is not misread as invalid octal.
    LAST_N=$(git tag --list "${TODAY}-*" | grep -oE '[0-9]+$' | sort -n | tail -1 || true)
    NEXT_N=$(printf '%02d' $((10#${LAST_N:-0} + 1)))
    TAG="${TODAY}-${NEXT_N}"
else
    TAG="$1"
fi
MAX_PRS="${2:-50}"

# Prerequisite: must be on main branch. Allow detached HEAD in GitHub Actions when
# the workflow ref points to main, since actions/checkout produces a detached HEAD.
CURRENT_BRANCH=$(git branch --show-current)
if [ -z "$CURRENT_BRANCH" ] && [ "${GITHUB_ACTIONS:-}" = "true" ] && [ "${GITHUB_REF:-}" = "refs/heads/main" ]; then
    CURRENT_BRANCH=main
fi
if [ -z "$CURRENT_BRANCH" ]; then
    echo "Error: repository is in detached HEAD state. Check out the 'main' branch first."
    exit 1
fi
if [ "$CURRENT_BRANCH" != "main" ]; then
    echo "Error: must be on the 'main' branch (currently on '$CURRENT_BRANCH')"
    exit 1
fi

# Prerequisite: claude CLI must be available, but only when summarization is requested.
if [ -z "$NO_SUMMARY" ] && ! command -v claude &>/dev/null; then
    echo "Error: 'claude' CLI not found. Install and authenticate before running, or pass --no-summary."
    exit 1
fi

# Prerequisite: gh CLI must be available and authenticated
if ! command -v gh &>/dev/null; then
    echo "Error: 'gh' CLI not found."
    exit 1
fi
if ! gh auth status &>/dev/null; then
    echo "Error: 'gh' CLI is not authenticated. Run: gh auth login"
    exit 1
fi

# Prerequisite: jq must be available (used throughout for JSON filtering)
if ! command -v jq &>/dev/null; then
    echo "Error: 'jq' not found. Install jq before running."
    exit 1
fi

# Surface the chosen tag for any wrapping workflow before doing real work.
if [ -n "${GITHUB_OUTPUT:-}" ]; then
    echo "tag=$TAG" >>"$GITHUB_OUTPUT"
fi

# Step 1: Find the previous tag and its commit date.
#
# We track the cutoff as both an ISO 8601 string (for display) and a unix
# epoch (for comparison). The epoch is timezone-agnostic — `git log %cI`
# carries the committer's offset (e.g. `-04:00`) while `gh pr list` returns
# `mergedAt` in UTC (`Z` suffix), and a naive lex compare misclassifies
# PRs near the cutoff by the size of that offset.
# git describe exits non-zero when no tags exist — cannot rely on set -e here.
if LAST_TAG=$(git describe --tags --abbrev=0 HEAD 2>/dev/null); then
    # Normal case: use the date of the tagged commit (lightweight tag — %cI is correct).
    # If this is ever changed to annotated tags, use "$LAST_TAG^{}" to dereference.
    LAST_TAG_DATE=$(git log -1 --format=%cI "$LAST_TAG")
    LAST_TAG_EPOCH=$(git log -1 --format=%ct "$LAST_TAG")
    echo "Previous tag: $LAST_TAG (date: $LAST_TAG_DATE)"
else
    # First run: no previous tag — collect all PRs from the beginning of history.
    FIRST_COMMIT=$(git rev-list --max-parents=0 HEAD)
    LAST_TAG_DATE=$(git log -1 --format=%cI "$FIRST_COMMIT")
    LAST_TAG_EPOCH=$(git log -1 --format=%ct "$FIRST_COMMIT")
    echo "No previous tag found — collecting all PRs since first commit (date: $LAST_TAG_DATE)"
fi

# Step 2: List merged PRs since previous tag.
#
# We deliberately avoid `gh pr list --search "merged:>X"` here: the search API
# is eventually consistent and can return an empty array when called from CI
# shortly after a merge. The default list endpoint is strongly consistent with
# merge events, so we fetch the most recent merged PRs from it and filter
# client-side.
ALL_MERGED=$(gh pr list \
    --state merged \
    --json number,title,body,author,mergedAt \
    --limit "$MAX_PRS")

PR_LIST=$(echo "$ALL_MERGED" |
    jq --argjson since "$LAST_TAG_EPOCH" \
        '[.[] | select((.mergedAt | fromdateiso8601) > $since)]')

# PR_COUNT: PRs that survived the mergedAt filter (used downstream).
# ALL_COUNT: PRs on the gh page before filtering (used to detect truncation).
PR_COUNT=$(echo "$PR_LIST" | jq length)
ALL_COUNT=$(echo "$ALL_MERGED" | jq length)
echo "Found $PR_COUNT merged PR(s) since last tag"

# Truncation guard: only warn when the oldest fetched PR is still newer than
# the cutoff — i.e. when truncation could plausibly have hidden an in-window
# PR. Heuristic only: `gh pr list` orders by created, not merged, so an old
# PR merged recently could in principle be paged off. Vanishingly unlikely at
# the default $MAX_PRS=50.
if [ "$ALL_COUNT" -gt 0 ] && [ "$ALL_COUNT" -eq "$MAX_PRS" ]; then
    OLDEST_EPOCH=$(echo "$ALL_MERGED" | jq 'min_by(.mergedAt).mergedAt | fromdateiso8601')
    if [ "$OLDEST_EPOCH" -gt "$LAST_TAG_EPOCH" ]; then
        echo "Warning: PR list may be truncated at $MAX_PRS results (pass a higher limit as second argument)"
    fi
fi

# Step 3: Separate human PRs from automated (dependabot) PRs
HUMAN_PRS_JSON=$(echo "$PR_LIST" | jq '[.[] | select(.author.login != "dependabot[bot]" and .author.login != "app/dependabot")]')
DEPENDABOT_PRS_JSON=$(echo "$PR_LIST" | jq '[.[] | select(.author.login == "dependabot[bot]" or .author.login == "app/dependabot")]')

HUMAN_COUNT=$(echo "$HUMAN_PRS_JSON" | jq length)
DEP_COUNT=$(echo "$DEPENDABOT_PRS_JSON" | jq length)
echo "Human PRs: $HUMAN_COUNT | Dependabot PRs: $DEP_COUNT"

# Step 4: Summarize human PRs (via Claude, or fall back to PR-title list)
SUMMARY=""
if [ "$HUMAN_COUNT" -gt 0 ]; then
    if [ -n "$NO_SUMMARY" ]; then
        echo "Skipping Claude summarization (--no-summary); using PR titles."
        SUMMARY=$(echo "$HUMAN_PRS_JSON" | jq -r '.[] | "- \(.title) (#\(.number))"')
    else
        echo "Summarizing $HUMAN_COUNT human PR(s) via Claude..."
        # PR titles/bodies are attacker-influenceable on a public repo and flow
        # through Claude into the published notes. The generated notes are printed
        # before the confirmation prompt below so the operator can catch an
        # injected payload; --yes/-y skips that gate — avoid it on untrusted history.
        # Disable set -e temporarily so we can handle Claude failures gracefully
        set +e
        SUMMARY=$(echo "$HUMAN_PRS_JSON" | claude -p \
            "These are merged pull requests since the last release. \
Write concise release notes in markdown. \
Group related changes. Use bullet points. \
Skip boilerplate like 'Closes #NNN'.")
        CLAUDE_EXIT=$?
        set -e

        if [ "$CLAUDE_EXIT" -ne 0 ]; then
            echo "Warning: Claude summarization failed (exit $CLAUDE_EXIT), falling back to PR title list" >&2
            SUMMARY=$(echo "$HUMAN_PRS_JSON" | jq -r '.[] | "- \(.title) (#\(.number))"')
        elif [ -z "$SUMMARY" ]; then
            echo "Warning: Claude returned empty output, falling back to PR title list" >&2
            SUMMARY=$(echo "$HUMAN_PRS_JSON" | jq -r '.[] | "- \(.title) (#\(.number))"')
        else
            echo "Claude summarization successful"
        fi
    fi
fi

# Step 5: Build release notes into a temp file
NOTES_FILE=$(mktemp -t tag-release-notes.XXXXXX)
# Default trap: clean up on successful exit
trap 'rm -f "$NOTES_FILE"' EXIT

{
    if [ "$HUMAN_COUNT" -gt 0 ]; then
        echo "$SUMMARY"
    elif [ "$DEP_COUNT" -gt 0 ]; then
        echo "No notable changes."
    else
        echo "No pull requests since last release."
    fi

    if [ "$DEP_COUNT" -gt 0 ]; then
        echo ""
        echo "<details>"
        echo "<summary>Dependency Updates</summary>"
        echo ""
        echo "$DEPENDABOT_PRS_JSON" | jq -r '.[] | "- \(.title) (#\(.number))"'
        echo ""
        echo "</details>"
    fi
} >"$NOTES_FILE"

echo "Release notes written to $NOTES_FILE"
cat "$NOTES_FILE"

# write_step_summary <heading> writes the run summary block to GITHUB_STEP_SUMMARY
# when set; no-op otherwise. Keeps GitHub-Actions wiring out of the main flow.
write_step_summary() {
    local heading="$1"
    if [ -z "${GITHUB_STEP_SUMMARY:-}" ]; then
        return 0
    fi
    {
        echo "## $heading"
        echo ""
        echo "**Tag:** \`$TAG\`"
        echo ""
        echo "### Release notes"
        echo ""
        cat "$NOTES_FILE"
    } >>"$GITHUB_STEP_SUMMARY"
}

# Dry run: stop after generating notes, before any tagging or release creation.
if [ -n "$DRY_RUN" ]; then
    echo ""
    echo "---"
    echo "Dry run: would create tag $TAG, push to origin, and create GitHub Release."
    echo "Skipping git tag, git push, and gh release create."
    write_step_summary "Tag Release (dry run)"
    trap - EXIT # keep notes file for inspection
    echo "Notes preserved at: $NOTES_FILE"
    exit 0
fi

# Step 6: Confirm before tagging (unless --yes)
echo ""
echo "---"
echo "Ready to create release: $TAG"
echo "This will: git tag $TAG && git push origin $TAG && gh release create $TAG"
echo ""
if [ -z "$YES" ]; then
    read -r -p "Proceed? [y/N] " CONFIRM
    if [[ ! $CONFIRM =~ ^[Yy]$ ]]; then
        trap - EXIT # keep notes file for inspection
        echo "Aborted. Release notes preserved at: $NOTES_FILE"
        exit 0
    fi
else
    echo "Proceeding without prompt (--yes)."
fi

# Step 7: Create git tag and push
git tag "$TAG"
git push origin "$TAG"
echo "Tag $TAG pushed to origin"

# Step 8: Create GitHub Release
# On failure: disarm the cleanup trap so the notes file is preserved for recovery
if ! gh release create "$TAG" --title "$TAG" --notes-file "$NOTES_FILE"; then
    trap - EXIT
    write_step_summary "Tag Release (release creation failed)"
    echo ""
    echo "Error: Tag pushed but GitHub Release creation failed."
    echo "Recover with: gh release create $TAG --notes-file $NOTES_FILE"
    exit 1
fi

write_step_summary "Tag Release"

echo ""
echo "Done! Tag $TAG pushed and GitHub Release created."
# The release already succeeded; a failure resolving the URL must not flip the
# exit code (a CI wrapper would wrongly retry and double-release).
REPO_SLUG=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
if [ -n "$REPO_SLUG" ]; then
    echo "View at: https://github.com/$REPO_SLUG/releases/tag/$TAG"
fi
