[user]
	email = olaf@wundersolutions.com
	name = Olaf Alders
[branch]
	sort = -committerdate
[column]
	ui = auto
[commit]
	verbose = true
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[github]
	user = oalders
[help]
	autocorrect = prompt
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	followTags = true
[rebase]
	autostash = true
	autosquash = true
	instructionFormat = (%an <%ae>) %s
	updateRefs = true
[rerere]
	enabled = true
	autoupdate = true
[alias]
	auto-set-head = remote set-head origin -a
	b = branch
	ba = branch -a
	can = commit --amend --no-edit
	changes = diff --name-status -r
	ci = commit
	co = checkout
	dc = diff --cached
	delete-untracked-files = clean -f -d
	deleted = log --diff-filter=D --
	diffstat = diff --stat -r
	# origin/HEAD aliases: run `git auto-set-head` if origin/HEAD is missing or dangling.
	dom = diff -w -M origin/HEAD...HEAD
	doms = diff -w -M origin/HEAD...HEAD --stat
	domo = diff -w -M origin/HEAD...HEAD --name-only
	flog = log --stat --abbrev-commit --relative-date --pretty=oneline
	from = "!git fetch -p && git rebase origin/HEAD"
	mylog = log --author=\"Olaf Alders\"
	plog = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	pf = push --force-with-lease
	rc = rebase --continue
	rgrep = grep --recurse-submodules
	revert-file-in-commit = "!f() { git show $2 -- $1 | git apply -R;}; f"
	root = rev-parse --show-toplevel
	st = status
	stu = status --untracked-files=no
	undo = reset --soft HEAD^
	view-stash = stash show -p stash@{0}
	whatis = show -s --pretty='tformat:%h (%s, %ad)' --date=short
[core]
	excludesfile = ~/.gitignore_global
	untrackedCache = true
[merge]
	tool = nvimdiff2
[tag]
	sort = version:refname
[grep]
	lineNumber = true
	patternType = perl
[delta]
	light = false
	navigate = true
