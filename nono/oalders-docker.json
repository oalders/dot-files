{
  "meta": {
    "name": "oalders-docker",
    "description": "Docker CLI mixin: CLI plugins, read-only ~/.docker slice, and daemon socket; rationale in nono/README.md"
  },
  "filesystem": {
    "read": [
      "/usr/libexec/docker/cli-plugins",
      "~/.docker/contexts"
    ],
    "read_file": [
      "~/.docker/config.json"
    ],
    "allow_file": [
      "/run/docker.sock",
      "/var/run/docker.sock"
    ],
    "unix_socket": [
      "/run/docker.sock",
      "/var/run/docker.sock"
    ]
  }
}
