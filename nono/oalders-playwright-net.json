{
  "meta": {
    "name": "oalders-playwright-net",
    "description": "Playwright browser-download hosts; rationale in nono/README.md"
  },
  "network": {
    "allow_domain": [
      "cdn.playwright.dev",
      "playwright.azureedge.net",
      "playwright.download.prss.microsoft.com",
      {
        "domain": "storage.googleapis.com",
        "endpoints": [
          { "method": "GET", "path": "/**" },
          { "method": "HEAD", "path": "/**" }
        ]
      }
    ]
  }
}
